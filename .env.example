# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Supabase (públicas: llegan al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SOLO servidor: nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (SOLO servidor, usado en rutas API)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_VISION_MODEL=

# URL pública del sitio (p. ej. http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
